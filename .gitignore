node_modules/
dist/
build/
.cache/
.env*
!.env.example
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Supabase CLI local link state/cache — machine-specific, not project source.
supabase/.temp/

# Claude Code per-machine local settings (e.g. which project MCP servers this
# machine has approved) — not shared project config, unlike .mcp.json.
.claude/settings.local.json

# Everything in /plans/ stays local-only by default (YC execution doc,
# cost-model notes, etc.) EXCEPT the two roadmap docs below, which are
# tracked deliberately so a cloud Claude Code session (e.g. started from
# the Claude app, no laptop needed) can actually see current priorities.
/plans/*
!/plans/regway-mvp-roadmap.md
!/plans/regway-ai-multi-agent-architecture.md

.DS_Store
