# Copy this file to .env.local and fill in the two values.
#
# For local development, use your own local Supabase (docs/onboarding.md):
# run `supabase start`, then `supabase status -o env`, and copy API_URL and
# ANON_KEY from its output. Those local keys are throwaway values that
# protect nothing outside your own machine.
#
# VITE_ variables are built into the browser bundle, so anyone can read
# them. Only the anon (publishable) key belongs here. Never a service role
# key, a database password, or an Anthropic key.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-ANON_KEY-from-supabase-status

# Optional, and only if the owner gave you a development AI key: it goes in
# supabase/functions/.env (not this file), as ANTHROPIC_API_KEY=...
# Without it the app runs, but matching, analyses and the chat return errors.
